# ==========================================
# KONFIGURASI ENVIRONMENT PRODUKSI KOPIRISE
# ==========================================

# Domain Aplikasi (contoh: kopirise.id atau localhost untuk pengujian)
KOPIRISE_DOMAIN=localhost

# Lingkungan: production / development
KOPIRISE_ENV=production

# Kunci Rahasia Sesi (Minimal 64 karakter acak kriptografis)
# Generate dengan: openssl rand -hex 32
KOPIRISE_SESSION_SECRET=a8f4c2e1b3d567890ef1234567890abcdef1234567890abcdef1234567890abcd

# CORS Origins yang Diizinkan (pisahkan dengan koma)
KOPIRISE_CORS_ALLOWED_ORIGINS=https://kopirise.id,http://localhost:3000

# Pengaturan Keamanan Hash Argon2id
KOPIRISE_ARGON2_MEMORY=65536
KOPIRISE_ARGON2_ITERATIONS=3
KOPIRISE_ARGON2_PARALLELISM=2

# Bootstrap Kredensial Pemilik Pertama (Opsional, di-seed di awal)
INITIAL_ADMIN_EMAIL=admin@kopirise.id
INITIAL_ADMIN_PASSWORD=GantiPasswordKuatIniSegera2026!
